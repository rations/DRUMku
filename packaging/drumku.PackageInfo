name			drumku
version			0.5.0-2
architecture	x86_64
summary			"DRUMku - MIDI drum sampler: VST3 plug-in and standalone app (RenkuOS)"
description		"A MIDI-triggered drum sampler: a rack of pads, each playing a WAV
sample from incoming MIDI notes (a drum kit, a keyboard or a sequencer). As a
native VST3 plug-in for hosts such as Kasen, and as the standalone DRUMku app
(Applications menu), which plays on the Media Kit or, with the jack package
installed, on JACK. The Steinberg VST3 SDK is linked statically (MIT)."
packager		"rations <ehqcar@proton.me>"
vendor			"rations"
copyrights {
	"2026 rations"
	"2025 Steinberg Media Technologies GmbH"
}
licenses {
	"MIT"
}
provides {
	drumku = 0.5.0
	app:DRUMku = 0.5.0
}
requires {
	haiku >= @HAIKU_MIN@
	libsamplerate
}
urls {
	"https://github.com/rations/DRUMku"
}
