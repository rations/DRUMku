/*
 * DRUMku standalone app resources: signature, launch behaviour, version and
 * icon (generated by tools/make_icon.py).
 * Compiled with rc and attached with xres by CMakeLists.txt.
 */

resource app_signature "application/x-vnd.rations-DRUMku";

resource app_flags B_SINGLE_LAUNCH;

#include "icons/drumku_icon.rdef"

resource app_version {
	major  = 0,
	middle = 5,
	minor  = 0,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "DRUMku",
	long_info = "DRUMku 0.5.0, MIDI drum sampler for the Media Kit or JACK"
};
